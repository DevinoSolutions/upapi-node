{
  "name": "@upapi/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the upAPI gateway — one method per public operation, generated from the operation catalog.",
  "keywords": [
    "upapi",
    "api",
    "sdk",
    "typescript",
    "client",
    "scraping",
    "serp"
  ],
  "license": "MIT",
  "homepage": "https://upapi.io/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/upapi-node.git"
  },
  "bugs": {
    "url": "https://app.upapi.io/support"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
